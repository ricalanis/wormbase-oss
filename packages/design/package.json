{
  "name": "@wormbase/design",
  "version": "0.1.0",
  "private": true,
  "description": "WormBase design tokens and primitive components — Field Notebook system.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./components": "./src/components/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
