{
  "name": "@wormbase/dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js dashboard for WormBase — Field Notebook design direction.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/visual/",
    "test:install": "playwright install --with-deps chromium",
    "lint": "tsx scripts/lint-anti-patterns.ts && eslint . --max-warnings=0 && tsc --noEmit",
    "lint:next": "eslint . --max-warnings=0",
    "lint:anti-patterns": "tsx scripts/lint-anti-patterns.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@wormbase/design": "workspace:*",
    "@xyflow/react": "^12.10.2",
    "next": "^15.0.3",
    "pg": "^8.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.20.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9",
    "eslint-config-next": "^15",
    "happy-dom": "^15.7.4",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
