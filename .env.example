# WormBase — required + optional secrets for local dev, demo, and prod.
#
# Copy to .env and fill the keys appropriate to the path you're running:
#   - `make tutorial` (warmup-only)         → no secrets strictly required
#   - `make tutorial` (CLI install)         → SLACK_BOT_TOKEN_BASEWORM
#   - dashboard "Connect to Slack" (OAuth)  → SLACK_CLIENT_ID + SECRET +
#                                              WORMBASE_DASHBOARD_URL
#   - sim-harness multi-persona scenarios   → SLACK_BOT_TOKEN_SIM_BASEWORM
#                                              + WORMBASE_AGENT_USER_ID
#
# Never commit .env. Every secret is keyed to a specific subsystem.
# Run `make doctor` after editing — it reports which keys are still
# missing and what each unblocks.

# ──────────────────────────────────────────────────────────────────────
# Required for any boot — written to ledger entries; rotate in prod.
# ──────────────────────────────────────────────────────────────────────
WORMBASE_LEDGER_API_TOKEN=dev-only-token-rotate-in-prod

# ──────────────────────────────────────────────────────────────────────
# Tenant identity — every operation carries a company_id slug.
# ──────────────────────────────────────────────────────────────────────
DEMO_WORKSPACE_ID=baseworm

# ──────────────────────────────────────────────────────────────────────
# Required for live Slack OAuth (Tier-0 "Connect to Slack" button on
# /onboarding). Without these, the start handler honestly redirects
# with ?error=slack_not_configured. Find them at:
#   https://api.slack.com/apps → your app → Basic Information
# WORMBASE_DASHBOARD_URL must be reachable from Slack's servers — use
# a Cloudflare quick-tunnel hostname or ngrok in local dev, the real
# domain in prod.
# ──────────────────────────────────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
WORMBASE_DASHBOARD_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────────────
# Required for the CLI seed install path
# (`wormbase demo seed --install-from-env`). One pair per tenant —
# OpenClaw routes the App Token, the channel-adapter uses the Bot
# Token. The CLI calls Slack's auth.test + users.info to derive the
# installer Person; xoxb tokens have no profile email, so set the
# override below for dev-tooling installs.
# ──────────────────────────────────────────────────────────────────────
SLACK_APP_TOKEN_BASEWORM=
SLACK_BOT_TOKEN_BASEWORM=
WORMBASE_INSTALLER_EMAIL_OVERRIDE=
WORMBASE_INSTALLER_NAME_OVERRIDE=

# ──────────────────────────────────────────────────────────────────────
# Two-Slack-app architecture (deterministic capture). A SECOND Slack
# app per tenant — the worm-core lurker uses it for 100% passive
# observation. Slack delivers every event to BOTH apps independently.
# ──────────────────────────────────────────────────────────────────────
SLACK_APP_TOKEN_OBSERVER_BASEWORM=
SLACK_BOT_TOKEN_OBSERVER_BASEWORM=

# ──────────────────────────────────────────────────────────────────────
# Required for sim-harness multi-persona scenarios. A THIRD Slack app
# per tenant (WormBase Sim) — POST-only with chat:write.customize so
# one bot posts under different persona usernames + icons.
# WORMBASE_AGENT_USER_ID is the WormBase bot's Slack user id from
# auth.test; sim-harness rewrites @WormBase → <@USER_ID> so mentions
# fire app_mention events instead of being literal text.
# ──────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN_SIM_BASEWORM=
WORMBASE_AGENT_USER_ID=
WORMBASE_AGENT_HANDLE=@WormBase

# ──────────────────────────────────────────────────────────────────────
# OpenClaw Gateway admin token — bridge auth between channel-adapter
# and gateway. Generate any 32-byte hex string for local dev; rotate
# in prod.
# ──────────────────────────────────────────────────────────────────────
OPENCLAW_ADMIN_TOKEN=

# ──────────────────────────────────────────────────────────────────────
# Inference
#   - Ollama Cloud (primary): hosts kimi-k2.6:cloud + gpt-oss fallback.
#     Get a key at https://ollama.com
#   - Moonshot (optional): direct Kimi K2.6 if strict-direct billing /
#     rate limits are needed; activate in infra/openclaw-config/config.json5.
#   - Gemma VLAN (optional): own-inference for fully on-prem.
# ──────────────────────────────────────────────────────────────────────
OLLAMA_API_KEY=
MOONSHOT_API_KEY=
GEMMA_VLAN_ENDPOINT=

# ──────────────────────────────────────────────────────────────────────
# Silent mode — process-global listen-only flag (PR-merged 2026-05-20).
# Truthy values (1, true, yes, on) gate ALL outbound side effects across
# the stack: Slack/Discord/Teams writes via channel-adapter, ElevenLabs
# voice replies, MCP write tools, /v1/ask responses, DM send_resource_
# conversation_dm. Inbound ingestion + ledger writes continue normally;
# suppressed actions land as first-class ledger entries you can audit.
# Default off. Spec: docs/superpowers/specs/2026-05-18-silent-mode-design.md
# ──────────────────────────────────────────────────────────────────────
WORMBASE_SILENT_MODE=0

# ──────────────────────────────────────────────────────────────────────
# MCP layer (Block J). Default OFF; set to 1 to bring up the FastMCP
# server on port 9911. With MCP disabled, /mcp/catalog 404s and the
# dashboard /mcp tab renders the honest empty state.
# ──────────────────────────────────────────────────────────────────────
WORMBASE_MCP_ENABLED=1
WORMBASE_MCP_PORT=9911
WORMBASE_MCP_CATALOG_URL=

# ──────────────────────────────────────────────────────────────────────
# Ledger + projections. Optional Supabase Postgres for hosted prod;
# local dev uses the docker-compose postgres service (auto-wired).
# ──────────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
WORMBASE_LEDGER_API_BASE=

# ──────────────────────────────────────────────────────────────────────
# Object storage (Block F6) — S3 or S3-compatible blob bytes for data
# product / notebook artifacts. LocalStack S3 is auto-wired in dev;
# swap to a real bucket in prod.
# ──────────────────────────────────────────────────────────────────────
WORMBASE_OBJECT_STORE_URI=s3://wormbase-dev/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL_S3=

# ──────────────────────────────────────────────────────────────────────
# KMS — production hardening for OAuth grants. Until WORMBASE_KMS_KEY_ID
# is set the dashboard wraps tokens with a Postgres _secrets fallback
# (vault://local-dev/...). WORMBASE_REQUIRE_KMS=1 makes the dashboard
# refuse the fallback explicitly. NEVER ship to prod without KMS.
# ──────────────────────────────────────────────────────────────────────
WORMBASE_KMS_KEY_ID=
WORMBASE_REQUIRE_KMS=

# ──────────────────────────────────────────────────────────────────────
# Voice agent — ElevenLabs Conversational AI. Order a phone number
# Monday for a Thursday demo; capture agent id and webhook auth token
# from the ElevenLabs console.
# ──────────────────────────────────────────────────────────────────────
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_TOKEN=

# ──────────────────────────────────────────────────────────────────────
# Worm-core tuning (optional — defaults are safe).
# ──────────────────────────────────────────────────────────────────────
WORM_CORE_LOOP_INTERVAL_S=
WORM_CORE_LOG_LEVEL=
WORMBASE_TENANT_ID=

# ──────────────────────────────────────────────────────────────────────
# L1 lake-side-compounding source-candidate discovery (opt-in).
#
# When enabled, the agent gateway runs strategies on a clock tick to
# surface candidate sources from the lake's accumulated context:
#
#   * channel_mention — regex-scans recent silver conversations (folded
#     from chat_received entries) for vendor names (Snowflake, Hubspot,
#     Notion, Linear, etc.). Default lookback 24h; override via WINDOW
#     in seconds (e.g. 604800 for 7d during demo / backfill).
#   * kpi_gap — surfaces unbacked KPI nodes that need a data source.
#   * complementarity — heuristic: portfolio gaps among connected sources.
#
# Candidates land in the ledger as `source_candidate_proposed`; the
# operator promotes (→ source-pipeline) or rejects via the
# `wormbase-source-candidates` CLI or the dashboard API. Silent-mode
# compatible: no autonomous action.
# ──────────────────────────────────────────────────────────────────────
WORMBASE_SOURCE_CANDIDATE_DISCOVERY_ENABLED=
WORMBASE_SOURCE_CANDIDATE_CHANNEL_MENTION_ENABLED=
WORMBASE_SOURCE_CANDIDATE_KPI_GAP_ENABLED=
WORMBASE_SOURCE_CANDIDATE_COMPLEMENTARITY_ENABLED=
WORMBASE_SOURCE_CANDIDATE_MIN_CONFIDENCE=
WORMBASE_SOURCE_CANDIDATE_CHANNEL_MENTION_WINDOW=

# ──────────────────────────────────────────────────────────────────────
# Hermes spike (deferred, profile-gated). Only set if you're explicitly
# bringing up the `hermes-spike` profile per the H1 spike note.
# ──────────────────────────────────────────────────────────────────────
WORMBASE_HERMES_SPIKE_ENDPOINT=
